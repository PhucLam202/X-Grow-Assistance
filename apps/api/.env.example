PORT=3001
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,chrome-extension://your_extension_id
TEXT_AI_PROVIDER=deepseek
VISION_AI_PROVIDER=openrouter
# Provider values: openai | deepseek | gemini | claude | openrouter
# Model values are configured separately below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-5-nano
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# MongoDB for Phase 3.2 personal memory
MONGODB_URI=mongodb://127.0.0.1:27017/x_comment_assistant
MONGODB_DB_NAME=x_comment_assistant
JWT_SECRET=change_me_to_a_long_random_secret
JWT_TTL_SECONDS=2592000

# Opportunity Scoring Cache
OPPORTUNITY_CACHE_TTL_SECONDS=600
